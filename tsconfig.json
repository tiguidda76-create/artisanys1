{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["craftBrainService.ts"],
  "exclude": ["node_modules", "dist", ".tmp"]
}
